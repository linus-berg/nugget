<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.1.0"/>
        <PackageReference Include="Polly.Core" Version="8.9.1"/>
        <PackageReference Include="NuGet.Packaging" Version="8.0.0"/>
        <!-- NuGet.Packaging still references a vulnerable 8.0.x build. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nugget.Tests"/>
    </ItemGroup>

</Project>
