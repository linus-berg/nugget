{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Nugget.Requests": "Information"
    }
  },
  "AllowedHosts": "*",
  "Nugget": {
    "ApiKey": "",
    "PublicBaseUrl": "",
    "MaxPackageBytes": 2147483648,
    "LogRequests": true,
    "Sync": {
      "PollIntervalSeconds": 5,
      "SnapshotIntervalMinutes": 15,
      "DownloadFlushSeconds": 60,
      "ChangeRetentionHours": 24
    }
  },
  "Storage": {
    "ServiceUrl": "",
    "Bucket": "nuget",
    "Prefix": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "ConditionalWrites": true,
    "CreateBucket": true
  }
}
