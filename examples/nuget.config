<?xml version="1.0" encoding="utf-8"?>
<!--
  Points every project in this folder (and below) at the development server
  (started with "dotnet run" in Nugget.Api) instead of nuget.org. Copy it next
  to your own test project or solution to do the same there.

    scripts/mirror-packages.sh         fill the server with example packages
    cd examples/SampleApp
    dotnet run                         restores everything from the server

  NuGet caches HTTP responses for 30 minutes; restore with the no-http-cache
  option while you are still adding packages to the server.
-->
<configuration>
  <packageSources>
    <!-- Ignore nuget.org and the sources of machine and user configs. -->
    <clear />
    <!-- The development server uses plain HTTP, which NuGet only allows when asked. -->
    <add key="nugget-dev" value="http://localhost:5080/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
  <config>
    <!--
      A package cache of its own (examples/.nuget-packages), so packages
      really come from the server and not from earlier nuget.org restores.
      Delete the folder to download everything again.
    -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
</configuration>
